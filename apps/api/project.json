{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/api"]
    },
    "docker-build": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Builds the Cloud Run image from dist/apps/api. Its build dependency runs the default configuration, which is production (NODE_ENV=production)."
      },
      "options": {
        "command": "docker build -f apps/api/Dockerfile -t {args.tag} dist/apps/api",
        "cwd": "{workspaceRoot}",
        "args": "--tag=saas-starter-api:local"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "grant-admin": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file-if-exists=.env apps/api/scripts/grant-admin.mts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck-scripts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "tsc -p apps/api/tsconfig.scripts.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "dependsOn": ["typecheck-scripts"]
    },
    "test-firestore": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-links-test \"npx vitest run --config apps/api/vitest.config.mts firestore.spec --no-file-parallelism\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
