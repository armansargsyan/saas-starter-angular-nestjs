{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@22", "mcp"]
    },
    "nx": {
      "command": "npx",
      "args": ["-y", "nx-mcp@latest"]
    },
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "mcp"]
    },
    "spartan": {
      "command": "npx",
      "args": ["-y", "@spartan-ng/mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1440x900",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
