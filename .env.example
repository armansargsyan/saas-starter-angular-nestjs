# Copy to `.env` and fill in. Never commit `.env`.
# The api validates these at startup and refuses to boot if any are invalid.

# ── API server ────────────────────────────────────────────────
# Both have defaults; uncomment to override. (Nx loads `.env` into every
# task, so an empty NODE_ENV= would leak into Vitest and the web build.)
# NODE_ENV=development
# PORT=3000
# Public origin of the app; short links are <APP_URL>/r/<code>
APP_URL=
# Proxies appending to X-Forwarded-For (default 1 = Cloud Run; 2 behind Firebase Hosting)
# TRUST_PROXY_HOPS=1

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
# Local Admin SDK credentials (not needed with the emulators or on Cloud Run):
# GOOGLE_APPLICATION_CREDENTIALS=
# Point the Admin SDK at the emulators (`npm run emulators`):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Stripe (test mode only: live keys are rejected) ──────────
# sk_test_…
STRIPE_SECRET_KEY=
# whsec_… (locally, printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# price_… for the Pro and Team plans
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
